# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# 本机 agent 脚手架（可依据 skills-lock.json 重新安装，不入库）
.agents/
.claude/

# Generated artifacts / demo snapshots (regenerated by each run)
assets/
runs/
*.png
*.jpg
*.jpeg
*.pt
*.cache
!models/custom_yolov8n_seg.pt

# 训练数据集：标签与图像必须成对入库，否则训练无法复现
!yolo_dataset/images/**/*.jpg
